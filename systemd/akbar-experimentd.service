[Unit]
Description=Akbar Experiment Service
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=akbar
Group=akbar
WorkingDirectory=/opt/akbar
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/akbar/database.env
ExecStart=/opt/akbar/.venv/bin/python -m experiment.ExperimentServer
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
