[Unit]
Description=Akbar Scheduler
After=mariadb.service akbar.service akbar-experimentd.service
Wants=mariadb.service akbar.service akbar-experimentd.service

[Service]
Type=simple
User=akbar
Group=akbar
WorkingDirectory=/opt/akbar
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/akbar/database.env
ExecStart=/opt/akbar/.venv/bin/python -m scheduler.SchedulerServer
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
